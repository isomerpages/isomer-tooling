                {
                  "type": "bold"
                }
              ],
              "text": "PES"
            },
            {
              "type": "text",
              "text": ") to explain ACE Technology Guidances are available for patients and the public."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": " Published on 02 Jan 2019 "
            },
            {
