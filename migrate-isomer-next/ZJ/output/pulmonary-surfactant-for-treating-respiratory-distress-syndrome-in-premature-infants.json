                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Calfactant 105 mg/3 ml and 210 mg/6 ml and poractant alfa 120 mg/1.5 ml intratracheal suspension vials for treating respiratory distress syndrome in premature infants."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
