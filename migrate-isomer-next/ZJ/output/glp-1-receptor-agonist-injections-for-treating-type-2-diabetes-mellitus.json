                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Dulaglutide 0.75 mg and 1.5 mg solution for injection in pre-filled pen is recommended for inclusion on the MOH Medication Assistance Fund (MAF) for the abovementioned indications from 1 February 2023."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does"
                        },
                        {
                          "type": "text",
                          "text": " "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "not "
                        },
                        {
                          "type": "text",
                          "text": "apply to any formulations or strengths of liraglutide or semaglutide for treating type 2 diabetes mellitus."
                        }
                      ]
                    }
                  ]
                }
              ]
