                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health's Drug Advisory Committee has recommended:"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Dulaglutide 0.75 mg and 1.5 mg solution for injection in pre-filled pen for treating type 2 diabetes mellitus:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "as a triple therapy in combination with two oral anti-diabetic drug (OAD) therapies for patients with inadequate glycaemic control despite treatment with optimal doses of dual OAD therapy, or as a dual therapy in combination with one OAD therapy if a dual OAD therapy is contraindicated or not tolerated; and"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "in combination with insulin and metformin, unless metformin is contraindicated or not tolerated."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
