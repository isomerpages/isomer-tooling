                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Cetuximab 100 mg/20 mL solution for infusion is recommended for inclusion on the SDL for the abovementioned indication with effect from 1 September 2022."
                        }
                      ]
