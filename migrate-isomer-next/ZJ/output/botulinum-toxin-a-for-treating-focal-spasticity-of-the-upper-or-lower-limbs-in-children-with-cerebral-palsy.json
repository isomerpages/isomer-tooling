          "content": [
            {
              "type": "text",
              "text": "A-"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A+"
            }
          ]
        },
        {
          "type": "table",
          "attrs": {
            "caption": "Table caption"
          },
          "content": [
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableHeader",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
