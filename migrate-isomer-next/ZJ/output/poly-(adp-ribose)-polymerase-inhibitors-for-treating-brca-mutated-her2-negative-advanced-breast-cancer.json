                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to olaparib 50 mg capsules or any formulations or strengths of talazoparib for treating BRCA-mutated, HER2-negative advanced breast cancer."
                        }
