                                {
                                  "type": "text",
                                  "text": "Sevelamer carbonate 800 mg tablet for the treatment of hyperphosphataemia in patients with chronic kidney disease who:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "have persistent hyperphosphataemia despite optimising treatment with calcium-based phosphate binders; or"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "cannot tolerate calcium-based phosphate binders due to hypercalcaemia."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
