                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Ciclosporin 0.1% eye drops, the only licensed ciclosporin eye preparation registered with the Health Sciences Authority, are recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication from 1 February 2023."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not"
                        },
                        {
                          "type": "text",
                          "text": " apply to other strengths or extemporaneous preparations of ciclosporin eye drops."
                        }
                      ]
                    }
                  ]
                }
              ]
