                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health's Drug Advisory Committee has not recommended listing polatuzumab vedotin on the Medication Assistance Fund (MAF) for treating patients with relapsed or refractory diffuse large B-cell lymphoma who are not eligible for haematopoietic cell transplant due to low clinical need, uncertain clinical effectiveness and unfavourable cost-effectiveness at the price proposed by the manufacturer."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            },
                            {
                              "type": "italic"
                            }
                          ],
                          "text": "Clinical indication, subsidy class and MediShield Life claim limit for polatuzumab vedotin are provided in the Annex."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
