                            }
                          ],
                          "text": "Clostridium botulinum "
                        },
                        {
                          "type": "text",
                          "text": "toxin type A neurotoxin complex (Botox) 50 U and 100 U injection vials are recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance"
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": " does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to Botox 200 U injection vial, Dysport 300 U and 500 U injection vials, and Xeomin 50 U and 100 U injection vials."
                        }
                      ]
