                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health's Drug Advisory Committee has recommended:"
                        },
                        {
                          "type": "hardBreak"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Ezetimibe 10 mg tablet for treating primary (heterozygous familial and non-familial) hypercholesterolaemia in adults as:"
                                },
                                {
                                  "type": "hardBreak"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Add-on therapy to statins when the cholesterol concentration therapeutic target is not achieved at the maximum tolerated statin dose; or"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Monotherapy as an alternative to statins for adults who are intolerant of, or contraindicated to, statin therapy."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": " Intolerance to statin therapy is defined as the occurrence of clinically significant adverse effects that are an unacceptable risk to the patient."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Subsidy status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Ezetimibe 10 mg tablet is recommended for inclusion on the MOH Standard Drug List (SDL) for the abovementioned indications."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "SDL subsidy "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to ezetimibe/simvastatin 10/10 mg or 10/20 mg tablets."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
