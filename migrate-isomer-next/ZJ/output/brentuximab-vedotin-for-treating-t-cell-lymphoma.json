                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Brentuximab vedotin 50 mg powder for infusion in line with its registered indications for treating:"
                                },
                                {
                                  "type": "hardBreak"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Previously untreated CD30-positive peripheral T-cell lymphoma when used with cyclophosphamide, doxorubicin and prednisone;"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Relapsed or refractory systemic anaplastic large cell lymphoma; and"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "CD30-positive cutaneous T-cell lymphoma, after at least one prior systemic therapy."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
