                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health’s Drug Advisory Committee has recommended:"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Abrocitinib 50 mg, 100 mg and 200 mg film-coated tablets for treating moderate-to severe atopic dermatitis in patients who have had an inadequate response, intolerance or contraindication to at least one systemic therapy such as ciclosporin, methotrexate, azathioprine and mycophenolate mofetil."
                                },
                                {
                                  "type": "hardBreak"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Funding status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Abrocitinib 50 mg, 100 mg and 200 mg film-coated tablets are recommended for inclusion on the MOH Medication Assistance Fund (MAF) for the abovementioned indication from 1 March 2024."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Abrocitinib should be used in line with additional clinical criteria for initial and continuing"
                        },
                        {
                          "type": "hardBreak"
                        },
                        {
                          "type": "text",
                          "text": "prescriptions for patients with moderate-to-severe atopic dermatitis."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance"
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": " does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to any formulations or strengths of baricitinib, upadacitinib or dupilumab for treating atopic dermatitis."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
