                      "content": [
                        {
                          "type": "text",
                          "text": "Guidance Recommendations"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health's Drug Advisory Committee has not recommended aflibercept, bevacizumab reference biologic (Avastin) or ramucirumab for subsidy for treating metastatic colorectal cancer."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Bevacizumab (Avastin) has not been recommended in view of unfavourable cost effectiveness compared with bevacizumab biosimilar (Mvasi) at the price proposed by the manufacturer."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Aflibercept has not been recommended due to low clinical need and unfavourable cost effectiveness compared with Mvasi."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Ramucirumab has not been recommended following a request from the manufacturer to not consider it for subsidy."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            },
                            {
                              "type": "italic"
                            }
                          ],
                          "text": "Clinical indications, subsidy class and MediShield Life claim limits for all drugs included in the evaluation are provided in the Annex."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
