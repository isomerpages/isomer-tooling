                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Guidance Recommendations"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health’s Drug Advisory Committee has recommended:"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Cabozantinib 20 mg, 40 mg and 60 mg tablets; and"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Regorafenib 40 mg tablet"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "for treating advanced unresectable hepatocellular carcinoma in patients with disease progression after one or more prior lines of systemic therapy, and who have adequate liver function as assessed by the Child-Pugh scoring system."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Subsidy status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Regorafenib 40 mg tablet is recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication with effect from 4 January 2022."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Cabozantinib 20 mg, 40 mg and 60 mg tablets are recommended for inclusion on the MAF for the abovementioned indication with effect from 1 September 2022."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to any formulations or strengths of ramucirumab, pembrolizumab, nivolumab and ipilimumab when used for previously treated advanced hepatocellular carcinoma."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            },
                            {
                              "type": "italic"
                            }
                          ],
                          "text": "Clinical indications, subsidy class and MediShield Life claim limits for all drugs included in the evaluation are provided in the Annex."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
