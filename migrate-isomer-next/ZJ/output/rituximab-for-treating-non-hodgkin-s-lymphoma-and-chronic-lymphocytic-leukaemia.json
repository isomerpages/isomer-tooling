                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health’s Drug Advisory Committee has recommended:"
                        },
                        {
                          "type": "hardBreak"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Rituximab biosimilar (Truxima) 100 mg/10 ml and 500 mg/50 ml concentrate for infusion for treating:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "CD20-positive diffuse large B-cell non-Hodgkin’s lymphoma,"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Indolent B-cell non-Hodgkin’s lymphomas,"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Stage III-IV follicular lymphoma, or"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "CD20-positive chronic lymphocytic leukaemia"
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": " in line with its registered indications; and"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "content": []
                        },
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "The removal of rituximab reference biologic 100 mg/10 ml and 500 mg/50 ml concentrate for infusion (MabThera) from the Medication Assistance Fund (MAF) for all indications."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
