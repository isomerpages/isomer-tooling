                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Umeclidinium 62.5mcg inhalation powder for the:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Maintenance treatment of patients diagnosed by spirometry with chronic obstructive pulmonary disease (Group B or C) who have breathlessness."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Umeclidinium/vilanterol 62.5/25mcg inhalation powder for the:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Maintenance treatment of patients diagnosed by spirometry with chronic obstructive pulmonary disease (Group B or C) who have frequent exacerbations (at least 2 per year or at least 1 leading to hospitalisation per year) and/or persistent breathlessness despite treatment with LAMA monotherapy."
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Maintenance treatment of patients diagnosed by spirometry with chronic obstructive pulmonary disease (Group D) with persistent symptoms and frequent exacerbations."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
