                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Regorafenib 40 mg tablet for treating metastatic colorectal cancer that has been previously treated with fluoropyrimidine-, oxaliplatin- and irinotecan-based chemotherapy, an anti-VEGF therapy, and if RAS wild-type, an anti-EGFR therapy."
                                },
                                {
                                  "type": "hardBreak"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
