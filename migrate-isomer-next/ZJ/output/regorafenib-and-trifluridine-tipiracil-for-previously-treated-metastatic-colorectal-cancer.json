                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to any formulations or strengths of trifluridine/tipiracil."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
