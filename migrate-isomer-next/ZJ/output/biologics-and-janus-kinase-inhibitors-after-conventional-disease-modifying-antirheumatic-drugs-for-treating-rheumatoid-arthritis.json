              "text": " ("
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "text": "PES"
            },
            {
              "type": "text",
              "text": ") to explain ACE Technology Guidances are available for patients and the public."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": " Published on 18 Jan 2021 "
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Last Updated on 01 Jul 2022"
            }
          ]
        },
