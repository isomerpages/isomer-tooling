          "content": [
            {
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "text": "ACE Technology Guidances "
            },
            {
              "type": "text",
              "text": "communicate recommendations from the MOH Drug Advisory Committee or the MOH Medical Technology Advisory Committee on the funding status and appropriate use of drugs, vaccines or medical technologies that have been evaluated by ACE. The guidances also include the Committee’s rationale for the funding recommendations, and key clinical and economic evidence which informed their deliberations. "
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "text": "Plain English Summaries"
            },
            {
              "type": "text",
              "text": " ("
            },
            {
              "type": "text",
              "marks": [
                {
                  "type": "bold"
                }
              ],
              "text": "PES"
            },
            {
              "type": "text",
              "text": ") to explain ACE Technology Guidances are available for patients and the public."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": " Published on 12 Jul 2022 "
            },
            {
              "type": "hardBreak"
            },
            {
              "type": "text",
              "text": "Last Updated on 02 Jan 2024"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A-"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "A+"
            }
          ]
        },
        {
          "type": "table",
          "attrs": {
            "caption": "Table caption"
          },
          "content": [
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableHeader",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Guidance Recommendations"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health's Drug Advisory Committee has recommended:"
                        },
                        {
                          "type": "hardBreak"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Avelumab 200 mg/10 mL concentrate for solution for infusion; and"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Pembrolizumab 100 mg/4 mL solution for infusion"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "for treating advanced urothelial carcinoma (UC) in line with specific clinical criteria."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Subsidy status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Avelumab 200 mg/10 mL concentrate for solution for infusion is recommended for inclusion on the Medication Assistance Fund (MAF) for maintenance treatment of locally advanced or metastatic UC that has not progressed with first-line platinum-based chemotherapy when used in line with the treatment regimen outlined in the Annex."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Pembrolizumab 100 mg/4 mL solution for infusion is recommended for inclusion on the MAF for treating patients with locally advanced or metastatic UC after receiving platinum-based chemotherapy in line with the following criteria:"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Patients must not have received prior treatment with a PD-1/PD-L1 inhibitor for locally advanced or metastatic UC; and"
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Treatment with pembrolizumab should be stopped at 2 years, or earlier if disease progresses. Pembrolizumab retreatment is allowed at time of progression for up to 1 additional year if the initial treatment was stopped for reasons other than disease"
                                },
                                {
                                  "type": "hardBreak"
                                },
                                {
                                  "type": "text",
                                  "text": "progression."
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance for the abovementioned treatments will be implemented from 1 September 2022."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to pembrolizumab when used for patients with untreated PD-L1-positive UC who are unable to receive cisplatin-based chemotherapy, or erdafitinib when used for treating UC with FGFR3 genetic alterations."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            },
                            {
                              "type": "italic"
                            }
                          ],
                          "text": "Clinical indications, subsidy class and MediShield Life claim limits for all drugs included in the evaluation are provided in the Annex."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
