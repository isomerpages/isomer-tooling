                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health's Drug Advisory Committee has not recommended daratumumab in combination with bortezomib, thalidomide and dexamethasone (DBTd), daratumumab in combination with lenalidomide and dexamethasone (DLd), and daratumumab in combination with bortezomib, melphalan and prednisone (DBMP) for inclusion on the MOH List of Subsidised Drugs for treating newly diagnosed multiple myeloma at the price proposed by the manufacturer."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The DBTd and DLd regimens have not been recommended in view of the uncertain extent of clinical benefit and uncertain cost-effectiveness compared with alternative treatments."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "The DBMP regimen has not been recommended in view of low clinical need for this treatment in local practice."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            },
                            {
                              "type": "italic"
                            }
                          ],
                          "text": "Clinical indications, subsidy class and MediShield Life claim limits for daratumumab are provided in the Annex."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
