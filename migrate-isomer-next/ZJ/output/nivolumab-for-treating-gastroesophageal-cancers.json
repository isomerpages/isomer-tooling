                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Nivolumab 40 mg/4 mL, 100 mg/10 mL and 240 mg/24 mL concentrate for solution for infusion are recommended for inclusion on the Cancer Drug List (Medication Assistance Fund and MediShield Life monthly claim limit of SG$1800) for the abovementioned indications from 1 September 2022."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
