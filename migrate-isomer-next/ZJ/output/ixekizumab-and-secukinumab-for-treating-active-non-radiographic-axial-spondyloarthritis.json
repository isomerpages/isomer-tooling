                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Secukinumab 150 mg/mL solution for injection in prefilled pen is recommended for inclusion on the MOH Medication Assistance Fund (MAF) for the abovementioned indication from 1 August 2023."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Secukinumab should be used in line with additional clinical criteria for initial and continuing prescriptions for adult patients with active non-radiographic axial spondyloarthritis."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does"
                        },
                        {
                          "type": "text",
                          "text": " "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "not "
                        },
                        {
                          "type": "text",
                          "text": "apply to ixekizumab, or any other formulations or strengths of secukinumab."
                        }
                      ]
                    }
                  ]
                }
