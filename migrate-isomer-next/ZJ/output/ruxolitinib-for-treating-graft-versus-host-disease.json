                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Ruxolitinib 5 mg, 15 mg and 20 mg tablets are recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication from 1 August 2024."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not"
                        },
                        {
                          "type": "text",
                          "text": " apply to ruxolitinib for treating moderate to severe "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "chronic"
                        },
                        {
                          "type": "text",
                          "text": " GVHD in patients who have an inadequate response to corticosteroids."
                        }
