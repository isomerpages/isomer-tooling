                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Ruxolitinib 5 mg, 15 mg and 20 mg tablets for treating grades II to IV "
                                },
                                {
                                  "type": "text",
                                  "marks": [
                                    {
                                      "type": "bold"
                                    }
                                  ],
                                  "text": "acute"
                                },
                                {
                                  "type": "text",
                                  "text": " graft-versus-host disease (GVHD) in patients who have an inadequate response to corticosteroids."
                                }
                              ]
                            },
                            {
