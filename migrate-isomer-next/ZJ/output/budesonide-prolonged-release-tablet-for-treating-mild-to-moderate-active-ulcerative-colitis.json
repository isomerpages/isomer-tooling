                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health’s Drug Advisory Committee has not recommended listing budesonide prolonged-release 9 mg tablet on the Medication Assistance Fund (MAF) for treating mild to moderate active ulcerative colitis because of uncertain comparative effectiveness and unfavourable cost effectiveness compared to alternative treatment options."
                        }
                      ]
                    }
                  ]
