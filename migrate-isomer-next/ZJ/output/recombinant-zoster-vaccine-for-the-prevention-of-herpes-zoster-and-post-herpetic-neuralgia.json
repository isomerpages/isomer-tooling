                              "content": [
                                {
                                  "type": "text",
                                  "text": "Recombinant varicella zoster virus glycoprotein E 50 mcg/0.5 mL powder and suspension for suspension for injection for the prevention of herpes zoster (HZ) and post-herpetic neuralgia in:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "adults 60 years of age or older; and"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "adults 18 years of age or older at increased risk of HZ due to immunodeficiency or immunosuppression caused by known disease or therapy."
                                        },
                                        {
                                          "type": "hardBreak"
                                        }
                                      ]
                                    }
                                  ]
                                }
