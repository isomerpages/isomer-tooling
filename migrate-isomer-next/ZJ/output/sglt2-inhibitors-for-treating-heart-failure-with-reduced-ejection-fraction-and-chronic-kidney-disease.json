                          "text": "Subsidy status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Empagliflozin 10 mg and 25 mg tablets are recommended for inclusion on the Standard Drug List (SDL) from 1 November 2023."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": " Of note, dapagliflozin 5 mg and 10 mg tablets will be delisted from the MOH List of Subsidised Drugs with effect from 1 August 2024 due to unfavourable cost-effectiveness compared with empagliflozin."
                        }
                      ]
                    }
                  ]
                }
              ]
