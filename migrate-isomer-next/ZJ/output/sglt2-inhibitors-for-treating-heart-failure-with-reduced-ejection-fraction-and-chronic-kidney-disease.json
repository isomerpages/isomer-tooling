                              "content": [
                                {
                                  "type": "text",
                                  "text": "Empagliflozin 10 mg and 25 mg tablets"
                                },
                                {
                                  "type": "hardBreak"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "in line with its registered indications for treating heart failure and chronic kidney disease, in view of favourable clinical and cost-effectiveness."
                        }
                      ]
                    }
                  ]
                }
              ]
            },
