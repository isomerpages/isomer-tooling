                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "PCV20 0.5 mL suspension for injection in pre-filled syringe is recommended for inclusion on the MOH Subsidised Vaccine List (SVL) for the abovementioned indication from September 2025."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Subsidy "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not"
                        },
                        {
                          "type": "text",
                          "text": " apply to pneumococcal conjugate vaccine 15-valent (PCV15)."
                        }
                      ]
                    }
                  ]
