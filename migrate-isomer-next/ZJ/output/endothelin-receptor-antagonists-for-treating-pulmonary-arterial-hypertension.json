                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Ambrisentan 5 mg and 10 mg tablets are recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to bosentan 62.5 mg and 125 mg tablets, and macitentan 10 mg tablet."
                        }
                      ]
                    }
                  ]
                }
              ]
