                              "type": "bold"
                            }
                          ],
                          "text": "Guidance Recommendations"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health’s Drug Advisory Committee has recommended:"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Burosumab 10 mg/mL, 20 mg/mL and 30 mg/mL solution for injection for treating X-linked hypophosphataemia (XLH) in adults and children 1 year of age and older, in line with the following criteria:"
                                }
                              ]
                            },
                            {
                              "type": "unorderedList",
                              "content": [
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Patient must have a documented confirmation of PHEX pathogenic variant; or"
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Patient must have a confirmed diagnosis of XLH demonstrated by the presence of all of the following:"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "unorderedList",
                                      "content": [
                                        {
                                          "type": "listItem",
                                          "content": [
                                            {
                                              "type": "paragraph",
                                              "attrs": {},
                                              "content": [
                                                {
                                                  "type": "text",
                                                  "text": "a serum phosphate concentration below the age adjusted lower limit of normal;"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "listItem",
                                          "content": [
                                            {
                                              "type": "paragraph",
                                              "attrs": {},
                                              "content": [
                                                {
                                                  "type": "text",
                                                  "text": "current or historical (for those with growth plate fusion) radiographic X-ray evidence of rickets;"
                                                }
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "listItem",
                                          "content": [
                                            {
                                              "type": "paragraph",
                                              "attrs": {},
                                              "content": [
                                                {
                                                  "type": "text",
                                                  "text": "renal phosphate wasting demonstrated by a ratio of tubular maximum reabsorption rate of phosphate to glomerular filtration rate (TmP/GFR) according to age specific normal ranges using the second morning urine void and paired serum sample measuring phosphate and creatinine; and"
                                                }
                                              ]
                                            }
                                          ]
                                        }
                                      ]
                                    }
                                  ]
                                },
                                {
                                  "type": "listItem",
                                  "content": [
                                    {
                                      "type": "paragraph",
                                      "attrs": {},
                                      "content": [
                                        {
                                          "type": "text",
                                          "text": "Patient must be treated by, or in consultation with, a specialist physician experienced in the diagnosis and management of XLH."
                                        }
                                      ]
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Funding status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Burosumab 10 mg/mL, 20 mg/mL and 30 mg/mL solution for injection are recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication from 1 August 2024."
                        }
                      ]
                    }
                  ]
                }
              ]
            }
