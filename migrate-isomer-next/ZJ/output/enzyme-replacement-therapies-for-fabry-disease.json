              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "The Ministry of Health’s Drug Advisory Committee has recommended:"
                        }
                      ]
                    },
                    {
                      "type": "unorderedList",
                      "content": [
                        {
                          "type": "listItem",
                          "content": [
                            {
                              "type": "paragraph",
                              "attrs": {},
                              "content": [
                                {
                                  "type": "text",
                                  "text": "Agalsidase alfa 3.5 mg/3.5 mL concentrate for solution for infusion as an enzyme replacement therapy in patients with Fabry disease. The treatment may be initiated only in:"
                                },
                                {
                                  "type": "hardBreak"
                                },
                                {
                                  "type": "text",
                                  "text": "a) Male patients with classical Fabry disease; or"
                                },
                                {
                                  "type": "hardBreak"
                                },
                                {
                                  "type": "text",
                                  "text": "b) Male patients with non-classical Fabry disease, or female patients with classical or non-classical Fabry disease, who have signs/symptoms of organ involvement (e.g. kidney, heart or nervous system) consistent with Fabry disease and which are not fully explained by other pathology."
                                },
                                {
                                  "type": "hardBreak"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "heading",
                      "attrs": {
                        "level": 3
                      },
                      "content": [
                        {
                          "type": "text",
                          "text": "Funding status"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "type": "tableRow",
              "content": [
                {
                  "type": "tableCell",
                  "attrs": {
                    "colspan": 1,
                    "rowspan": 1,
                    "colwidth": null
                  },
                  "content": [
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Agalsidase alfa 3.5 mg/3.5 mL concentrate for solution for infusion is recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication from 1 August 2024."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Agalsidase alfa should be used in line with the additional clinical criteria listed in the Annex."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "MAF assistance "
                        },
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            }
                          ],
                          "text": "does not "
                        },
                        {
                          "type": "text",
                          "text": "apply to agalsidase beta for treating Fabry disease."
                        },
                        {
                          "type": "hardBreak"
                        }
                      ]
