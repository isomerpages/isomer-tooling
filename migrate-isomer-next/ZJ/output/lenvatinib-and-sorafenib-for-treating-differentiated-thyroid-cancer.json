                      "type": "paragraph",
                      "attrs": {},
                      "content": [
                        {
                          "type": "text",
                          "text": "Sorafenib 200 mg tablet is recommended for inclusion on the MOH Standard Drug List (SDL) for the abovementioned indication with effect from 4 January 2022."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Lenvatinib 4 mg and 10 mg capsules are recommended for inclusion on the Medication Assistance Fund (MAF) for the abovementioned indication with effect from 1 September 2022."
                        }
                      ]
                    },
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "marks": [
                            {
                              "type": "bold"
                            },
                            {
                              "type": "italic"
                            }
                          ],
                          "text": "Clinical indications, subsidy class and MediShield Life claim limits for both drugs are provided in the Annex."
                        }
                      ]
                    }
                  ]
                }
              ]
